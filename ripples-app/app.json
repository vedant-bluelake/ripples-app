{
  "expo": {
    "name": "Ripples",
    "slug": "ripples-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "ripples",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1437"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.ripples.app" },
    "android": { "package": "com.ripples.app" },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router"]
  }
}
