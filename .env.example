# Backend API Configuration
# Copy this file to .env and fill in your actual backend URLs

# Shared staging backend base URL
EXPO_PUBLIC_API_BASE_URL=https://www.api.bluelakeinvesting.com/api

# Optional API path suffixes (kept for compatibility)
EXPO_PUBLIC_AUTH_PATH=/auth
EXPO_PUBLIC_USER_PATH=/users
EXPO_PUBLIC_BASKET_PATH=/baskets
EXPO_PUBLIC_ORDERS_PATH=/orders
EXPO_PUBLIC_FUND_PATH=/funds
EXPO_PUBLIC_MANDATE_PATH=/mandates
EXPO_PUBLIC_NOTIFICATIONS_PATH=/notifications

# API Timeout (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT=30000

# Environment
EXPO_PUBLIC_ENVIRONMENT=staging
